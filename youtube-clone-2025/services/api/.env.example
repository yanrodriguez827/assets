PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:4000

# Drivers: sqlite|postgres, fs|s3, sqlite|redis|memory
DB_DRIVER=sqlite
STORAGE_DRIVER=fs
QUEUE_DRIVER=sqlite

# SQLite
SQLITE_PATH=../../data/dev.sqlite

# Local filesystem storage
FS_STORAGE_DIR=../../data/storage
UPLOAD_MAX_BYTES=1073741824

# JWT/cookies (min 32 chars each)
JWT_ACCESS_SECRET=replace-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-refresh-secret-at-least-32-chars
COOKIE_SECRET=replace-me-cookie-secret-at-least-32-chars

# Optional Postgres
DATABASE_URL=postgresql://youtube:youtube@localhost:5432/youtube

# Optional Redis
REDIS_URL=redis://localhost:6379

# Optional S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_BUCKET=youtube
S3_PUBLIC_BASE_URL=http://localhost:9000/youtube
